# Copy to .env for local runs. Every value here is a DEV default; production values come from
# AWS SSM / Secrets Manager (see deploy/aws/README.md).
SLOTWISE_ENV=dev
SLOTWISE_DATABASE_URL=postgresql+asyncpg://slotwise_app:slotwise_app@localhost:55436/slotwise
SLOTWISE_MIGRATION_DATABASE_URL=postgresql+asyncpg://slotwise:slotwise@localhost:55436/slotwise
SLOTWISE_WORKER_DATABASE_URL=postgresql+asyncpg://slotwise_worker:slotwise_worker@localhost:55436/slotwise
SLOTWISE_REDIS_URL=redis://localhost:56383/0
SLOTWISE_CELERY_BROKER_URL=redis://localhost:56383/1
SLOTWISE_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SLOTWISE_FERNET_KEY=
SLOTWISE_MOCKPAY_WEBHOOK_SECRET=dev-mockpay-secret
SLOTWISE_SMTP_HOST=localhost
SLOTWISE_SMTP_PORT=51025
SLOTWISE_S3_BUCKET=slotwise-uploads
SLOTWISE_S3_ENDPOINT_URL=http://localhost:59002
# SLOTWISE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:54317
