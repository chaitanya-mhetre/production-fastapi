# DEV-ONLY values for the docker compose stack. Never reuse these anywhere real.
SLOTWISE_ENV=dev
SLOTWISE_DATABASE_URL=postgresql+asyncpg://slotwise_app:slotwise_app@postgres:5432/slotwise
SLOTWISE_MIGRATION_DATABASE_URL=postgresql+asyncpg://slotwise:slotwise@postgres:5432/slotwise
SLOTWISE_WORKER_DATABASE_URL=postgresql+asyncpg://slotwise_worker:slotwise_worker@postgres:5432/slotwise
SLOTWISE_REDIS_URL=redis://redis:6379/0
SLOTWISE_CELERY_BROKER_URL=redis://redis:6379/1
SLOTWISE_SMTP_HOST=mailpit
SLOTWISE_SMTP_PORT=1025
# Presigning is local crypto, so these dummy values work for issuing upload URLs. To actually
# upload locally, point SLOTWISE_S3_ENDPOINT_URL at any S3-compatible store you run.
SLOTWISE_S3_BUCKET=slotwise-uploads
AWS_ACCESS_KEY_ID=dev-access-key
AWS_SECRET_ACCESS_KEY=dev-secret-key
SLOTWISE_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SLOTWISE_WORKER_METRICS_PORT=9101
SLOTWISE_RELAY_METRICS_PORT=9102
SLOTWISE_WEBHOOK_ALLOW_PRIVATE_TARGETS=true
